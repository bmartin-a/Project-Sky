# ---------------------------------------------------------------------------
# Project-Sky environment configuration. Copy to `.env` and fill in.
# `.env` is git-ignored — never commit real secrets.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=projectsky
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=projectsky
# Connection string consumed by the API and Worker.
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=projectsky;Username=projectsky;Password=change-me-in-prod

# --- Redis (SignalR backplane + cache; NOT the job queue) ---
ConnectionStrings__Redis=redis:6379

# --- Host ports (local/base compose) ------------------------------------
# Change these if 8080/3000 are already in use on your machine.
API_PORT=8080
WEB_PORT=3000

# --- Authentication ------------------------------------------------------
# LocalDev (dev only, no login) vs Oidc (production). The base compose runs
# LocalDev in Development; the prod overlay (docker-compose.prod.yml) forces Oidc.
Auth__Mode=LocalDev

# BACKEND token validation (Auth__Mode=Oidc). Azure Entra ID example:
#   Authority = https://login.microsoftonline.com/<tenant-id>/v2.0
#   Audience  = api://<api-app-id>   (must equal the access token's aud)
Auth__Oidc__Authority=
Auth__Oidc__Audience=
# App role that grants admin, and the claim it's read from (Entra: "roles").
Auth__Oidc__AdminRole=Admin
Auth__Oidc__RoleClaim=roles

# FRONTEND sign-in (docker-compose.prod.yml → the SPA). Usually the same Entra
# app registration. OIDC_SCOPE must include the API scope so the browser gets an
# access token for the API, e.g. "openid profile api://<api-app-id>/access_as_user".
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile

# Public origin the app is served from (for CORS + reference), e.g.
# https://scanner.example.com
PUBLIC_ORIGIN=
# Host port the frontend publishes (put an HTTPS reverse proxy in front of it).
FRONTEND_PORT=8088

# --- Microsoft Defender ingestion (optional) ----------------------------
# Leave blank to disable the Defender ingestion job.
Defender__TenantId=
Defender__ClientId=
Defender__ClientSecret=

# --- NVD sync -----------------------------------------------------------
# Strongly recommended: request a free API key at
# https://nvd.nist.gov/developers/request-an-api-key
# Without a key the NVD API is throttled to ~5 requests / 30s.
Nvd__ApiKey=
Nvd__SyncCron=0 3 * * *

# --- Scanner tooling ----------------------------------------------------
Scanner__NmapPath=/usr/bin/nmap
Scanner__NucleiPath=/usr/local/bin/nuclei
Scanner__DefaultScanTimeoutSeconds=1800
# OWASP ZAP daemon (web active scanning), added in Milestone 2.
Zap__BaseUrl=http://zap:8080
Zap__ApiKey=change-me

# --- Data Protection ----------------------------------------------------
# Directory (mounted volume) where the Data Protection key ring is persisted.
DataProtection__KeyPath=/keys
