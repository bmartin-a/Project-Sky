# Shared image for the API and Worker. Pick the project with --build-arg PROJECT=...
# Build context is the repository root.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore against the whole solution so Directory.*.props + central versions apply.
COPY ProjectSky.slnx Directory.Build.props Directory.Packages.props ./
COPY src/ src/
ARG PROJECT
RUN dotnet restore "src/${PROJECT}/${PROJECT}.csproj"
RUN dotnet publish "src/${PROJECT}/${PROJECT}.csproj" -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Scanner tooling: nmap (network) + nuclei (web) + trivy (container images).
ARG NUCLEI_VERSION=3.3.7
ARG TRIVY_VERSION=0.58.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends nmap ca-certificates wget unzip libcap2-bin \
    && wget -q "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_amd64.zip" -O /tmp/nuclei.zip \
    && unzip -o /tmp/nuclei.zip -d /usr/local/bin nuclei \
    && rm /tmp/nuclei.zip \
    && wget -q "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" -O /tmp/trivy.tar.gz \
    && tar -xzf /tmp/trivy.tar.gz -C /usr/local/bin trivy \
    && rm /tmp/trivy.tar.gz \
    # Grant nmap raw-socket capability so it works as a non-root user
    # (SYN scan / OS detection). The container must also be started with
    # cap_add: [NET_RAW] — see docker-compose.yml.
    && setcap cap_net_raw+eip /usr/bin/nmap \
    && apt-get purge -y wget unzip && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Run as a non-root user.
RUN useradd --system --uid 10001 --create-home sky \
    && mkdir -p /keys && chown sky:sky /keys
USER sky

# Bake nuclei templates into the image so web scans don't fetch them at runtime.
# `|| true` keeps the build resilient if the templates host is unreachable.
RUN nuclei -update-templates -disable-update-check || true

COPY --from=build --chown=sky:sky /app/publish ./

ARG PROJECT
ENV APP_DLL=${PROJECT}.dll
ENTRYPOINT dotnet /app/${APP_DLL}
